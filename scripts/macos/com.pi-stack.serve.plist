<?xml version="1.0" encoding="UTF-8"?>
<!-- pi-stack host services as a macOS launchd user agent.
     Install:
       cp scripts/macos/com.pi-stack.serve.plist ~/Library/LaunchAgents/
       # edit ProgramArguments path + HOME below to your user if needed
       launchctl load -w ~/Library/LaunchAgents/com.pi-stack.serve.plist
     Stop:  launchctl unload ~/Library/LaunchAgents/com.pi-stack.serve.plist
     Logs:  ~/Library/Logs/pi-stack-serve.{out,err}.log
     This runs `pi-stack-host serve` (memory :11435, gws :11441 — from your
     ~/.config/pi-stack/config.toml SERVICES). The sandbox reaches these over
     host.docker.internal. Ollama (if used for memory) must be running too. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pi-stack.serve</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Absolute path — launchd has a minimal PATH. Adjust to where
         `make install` / install.sh put the binary (~/.local/bin/pi-stack-host). -->
    <string>/Users/CHANGEME/.local/bin/pi-stack-host</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Needed so the memory watcher/embed can reach a local Ollama. -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/CHANGEME/Library/Logs/pi-stack-serve.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGEME/Library/Logs/pi-stack-serve.err.log</string>
</dict>
</plist>
