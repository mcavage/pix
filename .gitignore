pi-stack.tar
*.zip
.DS_Store
node_modules/
.pi-sessions/
.pi-lens/

# Launcher-generated per-run knowledge scope (canonical HOST paths). The
# .pi-stack/knowledge POINTER stays trackable; only the .scope file is ignored.
**/.pi-stack/knowledge.scope

# Launcher-generated per-run active-profile name (scopes in-VM memory recall/
# capture). Regenerated every `pi-stack run`; never tracked.
**/.pi-stack/profile
# Local model tag the in-VM ollama-bridge exposes (from `pi-stack config set
# ollama_bridge_model`). Regenerated every `pi-stack run`; never tracked.
**/.pi-stack/ollama-bridge.model
# Host-state truth file (keys/services/pack/host facts the in-VM agent reads).
# Machine-specific (absolute paths, account names); regenerated every run.
**/.pi-stack/host-state.json
# First-run onboarding markers: the launcher-written offer marker and the
# agent-written control-plane proposal (consumed + deleted by the host). Neither
# is ever tracked.
**/.pi-stack/onboarding.offer
**/.pi-stack/onboarding.json
**/.pi-stack/onboarding.state


# 1Password secret references — user-specific (vault/item names); keep local
config/op-refs.env


# all build + sandbox artifacts land here (single ignored dir)
out/


# --- Open-core boundary: skills (MUST mirror .dockerignore) ---------------------
# DEFAULT-DENY so `git add -A` can never stage a company/overlay skill (one that
# carries proprietary schema or figures) into the public repo. Only the generic
# CORE skills below are tracked; everything else stays local.
# Keep this list in sync with the !skills/... allowlist in .dockerignore.
skills/*
!skills/agent-new/
!skills/anti-slop/
!skills/api-conventions/
!skills/brainstorm/
!skills/build/
!skills/capability-routing/
!skills/challenge/
!skills/code-review/
!skills/competitive/
!skills/conventions/
!skills/debug/
!skills/delegation-guide/
!skills/deliver/
!skills/design-review/
!skills/design-system/
!skills/docs-standards/
!skills/docs-sync/
!skills/enrich/
!skills/git-conventions/
!skills/guard/
!skills/gworkspace/
!skills/healthcheck/
!skills/ingest/
!skills/microcopy/
!skills/model-refresh/
!skills/onboarding/
!skills/one-pager/
!skills/peer-review/
!skills/plan/
!skills/promote/
!skills/qa/
!skills/ship/
!skills/tdd/
!skills/verify/
!skills/writing-voice/

# --- Open-core boundary: agents (MUST mirror .dockerignore) ---------------------
# DEFAULT-DENY so git add -A can't stage a future company-specific persona.
agents/*
!agents/architect.md
!agents/deep.md
!agents/designer.md
!agents/devrel.md
!agents/dx-consultant.md
!agents/dx-impatient.md
!agents/engineer.md
!agents/enrich.md
!agents/enterprise-admin.md
!agents/fanout.md
!agents/finance-analyst.md
!agents/growth-marketing.md
!agents/legal.md
!agents/product-manager.md
!agents/qa-lead.md
!agents/review.md
!agents/security-lead.md
!agents/sre-lead.md
!agents/ux-copywriter.md

# --- Private overlay (see docs/OVERLAY.md) ------------------------------------
# The overlay is its OWN peer repo (default ../pi-stack-work), not in this tree.
# `make serve` symlinks its host plugins into services/host/ as overlay_*.go so they
# compile into pi-stack-host; the symlinks are gitignored and the public binary
# builds identically without them.
services/host/overlay_*.go

# Compiled pi-stack-host binary (build artifact from `make serve` / `go build`).
services/host/host

# Private open-core marker list (codenames/account ids) — see the .example
config/open-core-markers.txt
.scratch/
.pi-agent/
services/host/pi-stack
services/host/pi-stack-host
# stray `go build` artifact if you compile inside the launcher package dir
services/host/cmd/pi-stack/pi-stack

# stray cross-compile artifacts
*.exe
