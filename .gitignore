pix.tar
*.zip
.DS_Store
node_modules/
.pi-sessions/
.pi-lens/

# Pix workspace runtime state is machine-local. Keep the optional knowledge
# pointer trackable while ignoring every other generated .pix entry.
**/.pix/*
!**/.pix/knowledge

# Launcher-generated per-run knowledge scope (canonical HOST paths). The
# .pix/knowledge POINTER stays trackable; only the .scope file is ignored.
**/.pix/knowledge.scope

# Launcher-generated per-run active-profile name (scopes in-VM memory recall/
# capture). Regenerated every `pix run`; never tracked.
**/.pix/profile
# Local model tag the in-VM ollama-bridge exposes (from `pix config set
# ollama_bridge_model`). Regenerated every `pix run`; never tracked.
**/.pix/ollama-bridge.model
# Host-state truth file (keys/services/pack/host facts the in-VM agent reads).
# Machine-specific (absolute paths, account names); regenerated every run.
**/.pix/host-state.json
# First-run onboarding markers: the launcher-written offer marker and the
# agent-written control-plane proposal (consumed + deleted by the host). Neither
# is ever tracked.
**/.pix/onboarding.offer
**/.pix/onboarding.json


# Pack activation provenance (pack.lock) — generated by `pix pack use`,
# records what the LAST activation contributed to cfg.MCP/knowledge_bundles so a
# switch can remove exactly that (packs-v2-impl.md ADR-1). Lives inside a pack's
# OWN root (a separate git repo the user owns); `pix pack new` seeds a
# pack-local .gitignore line for it too. Listed here as well in case any pack
# fixture ever ends up inside this checkout (e.g. an example/test pack).
**/pack.lock

# 1Password secret references — user-specific (vault/item names); keep local
config/op-refs.env


# all build + sandbox artifacts land here (single ignored dir)
out/


# --- Open-core boundary: skills (MUST mirror .dockerignore) ---------------------
# DEFAULT-DENY so `git add -A` can never stage a company/private-pack skill (one that
# carries proprietary schema or figures) into the public repo. Only the generic
# CORE skills below are tracked; everything else stays local.
# Keep this list in sync with the !skills/... allowlist in .dockerignore.
skills/*
!skills/analyze/
!skills/anti-slop/
