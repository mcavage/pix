# pi-stack local config. `make install` copies this to config/local.mk (which is
# gitignored). This is the SINGLE place to configure the stack — make serve / run
# / mcp-register / doctor / pull-models all read from here, so you never pass
# flags by hand.

# Host services `make serve` runs. Valid: memory. Trim to what you use.
SERVICES = memory

# MCP servers `make run` auto-attaches and `make mcp-register` registers.
# IMPORTANT: local stdio servers (e.g. slack, gog) MUST be listed here to be
# usable — dynamic discovery does NOT surface them, and this sbx can't attach to
# a running sandbox. Leave empty for pure dynamic mode (remote catalog only).
# Add `gog` here to enable the host-side Google Workspace MCP server (also set
# GOG_ACCOUNT below and the GOG_* refs in config/op-refs.env). E.g. MCP = slack gog
MCP = slack

# The Google account the host-side `gog` MCP server runs as (used only when `gog`
# is in MCP). Passed to `gog --account` by `make mcp-register`.
GOG_ACCOUNT ?=

# Local Ollama models for the self-learning memory (`make pull-models` fetches
# them). watcher = fact capture, embed = semantic recall. The watcher default is
# small on purpose: it runs on the HOST during `make serve` and Ollama keeps it
# resident, so a 26-31B model OOMs a 16GB laptop. Bump it (e.g. gemma3:12b) on a
# roomier machine for sharper fact extraction.
MEMORY_WATCHER_MODEL = gemma3:4b
MEMORY_EMBED_MODEL   = nomic-embed-text

# Private, company-specific integrations (a Snowflake proxy, a BambooHR directory,
# etc.) live in config/overlay.mk + gitignored services/host/*.go — not in this
# public config.
