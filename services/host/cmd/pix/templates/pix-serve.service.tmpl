# pix host services as a systemd --user unit.
# GENERATED by `pix serve install` (template embedded in the launcher —
# re-run `pix serve install` instead of hand-editing).
# Logs: {{.LogPath}} (same unified file the lazy auto-start and the launchd
# plist also log to; `journalctl --user -u pix-serve` still works too).
[Unit]
Description=pix host services (memory :11435, knowledge :11436)

[Service]
# HostBin is systemd-quoted by the renderer (a path with spaces stays one argv
# element); Environment entries carry the install-time env capture, one quoted
# KEY=value per line (PIX_CONFIG always; XDG_CONFIG_HOME / MEMORY_DB /
# MEMORY_PORT / KNOWLEDGE_PORT / OLLAMA_HOST when set at install time).
ExecStart={{.HostBin}} serve
StandardOutput=append:{{.LogPath}}
StandardError=append:{{.LogPath}}
{{- range .Env}}
Environment={{.Value}}
{{- end}}
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
