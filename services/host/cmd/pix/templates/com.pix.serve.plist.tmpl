<?xml version="1.0" encoding="UTF-8"?>
<!-- pix host services as a macOS launchd user agent.
     GENERATED by `pix serve install` (this template is the single source
     of truth, embedded in the launcher binary — do not hand-edit the installed
     copy; re-run `pix serve install` instead).
     Uninstall:  pix serve uninstall
     Logs:       one unified file — see StandardOutPath / StandardErrorPath
                 below (both point at the same path: config.ServeLogPath(),
                 the same file the lazy auto-start and the managed systemd
                 unit also log to).
     This runs `pix-host serve` (memory :11435, knowledge :11436 — from
     your ~/.config/pix/config.toml services). The sandbox reaches these
     over host.docker.internal. Google Workspace (gog) is NOT part of serve —
     it's a host MCP server run by the sbx gateway (see `make mcp-register`).
     Ollama (if used for memory) must be running too.
     NOTE (round 2, H8): no user-interpolated value (Home/LogPath/HostBin)
     may ever appear inside THIS comment. XML text-escaping does not make two
     adjacent hyphens legal inside a comment body, and a home directory or
     path with two adjacent hyphens in it would render an invalid plist. Those
     values already have proper string/key elements below (ProgramArguments,
     StandardOutPath, StandardErrorPath); put any new mention of them there,
     not here. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{.Label}}</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Absolute, symlink-resolved path — launchd has a minimal PATH. -->
    <string>{{.HostBin}}</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Needed so the memory watcher/embed can reach a local Ollama. -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <!-- Install-time env captured so the daemon reads the SAME config/store/
         ports as the launcher that installed it: PIX_CONFIG always
         (pinned absolute), plus XDG_CONFIG_HOME / MEMORY_DB / MEMORY_PORT /
         KNOWLEDGE_PORT / OLLAMA_HOST when set at install time. -->
{{- range .Env}}
    <key>{{.Key}}</key>
    <string>{{.Value}}</string>
{{- end}}
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{.LogPath}}</string>
  <key>StandardErrorPath</key>
  <string>{{.LogPath}}</string>
</dict>
</plist>
