{
  "verb": "secret",
  "cases": [
    {
      "name": "help",
      "args": [
        "secret",
        "--help"
      ],
      "exitCode": 0,
      "stream": "stdout",
      "contains": [
        "Usage: pix secret"
      ]
    },
    {
      "name": "bad-invocation",
      "args": [
        "secret",
        "--this-is-not-a-real-flag-9x7z"
      ],
      "exitCode": 2,
      "stream": "stderr",
      "contains": [
        "unknown flag"
      ]
    },
    {
      "name": "set-rejects-a-non-env-var-name",
      "args": [
        "secret",
        "set",
        "not-an-env-var",
        "op://v/i/f"
      ],
      "exitCode": 1,
      "stream": "stderr",
      "contains": [
        "pix secret set: \"not-an-env-var\" does not look like an env var name"
      ]
    },
    {
      "name": "set-rejects-a-literal-value",
      "args": [
        "secret",
        "set",
        "ANTHROPIC_API_KEY",
        "literal-value"
      ],
      "exitCode": 1,
      "stream": "stderr",
      "contains": [
        "is not an op:// reference — secrets.env holds op://vault/item/field references only"
      ]
    },
    {
      "name": "ls-with-no-secrets-configured",
      "args": [
        "secret",
        "ls"
      ],
      "exitCode": 0,
      "stream": "stdout",
      "contains": [
        "No secrets configured. Set one with: pix secret set NAME op://vault/item/field"
      ]
    }
  ]
}
