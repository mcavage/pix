{
  "verb": "secret",
  "cases": [
    {
      "name": "help",
      "args": [
        "secret",
        "--help"
      ],
      "exitCode": 0,
      "stream": "stdout",
      "contains": [
        "Usage: pix secret"
      ]
    },
    {
      "name": "bad-invocation",
      "args": [
        "secret",
        "--this-is-not-a-real-flag-9x7z"
      ],
      "exitCode": 2,
      "stream": "stderr",
      "contains": [
        "unknown flag"
      ]
    },
    {
      "name": "set-rejects-a-non-env-var-name",
      "args": [
        "secret",
        "set",
        "not-an-env-var",
        "op://v/i/f"
      ],
      "exitCode": 2,
      "stream": "stdout",
      "contains": [
        "pix secret set: \"not-an-env-var\" does not look like an env var name"
      ]
    },
    {
      "name": "set-rejects-a-literal-value",
      "args": [
        "secret",
        "set",
        "ANTHROPIC_API_KEY",
        "literal-value"
      ],
      "exitCode": 2,
      "stream": "stdout",
      "contains": [
        "is not an op:// ref — this file is refs-only"
      ]
    },
    {
      "name": "check-without-a-refs-file",
      "args": [
        "secret",
        "check"
      ],
      "exitCode": 3,
      "stream": "stdout",
      "contains": [
        "op-refs.env not found"
      ]
    },
    {
      "name": "sync-without-a-refs-file",
      "args": [
        "secret",
        "sync"
      ],
      "exitCode": 3,
      "stream": "stdout",
      "contains": [
        "pix secret sync: op-refs.env not found",
        "pix models add anthropic"
      ]
    }
  ]
}
