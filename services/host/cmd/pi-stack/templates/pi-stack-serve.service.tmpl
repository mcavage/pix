# pi-stack host services as a systemd --user unit.
# GENERATED by `pi-stack serve install` (template embedded in the launcher —
# re-run `pi-stack serve install` instead of hand-editing).
# Logs: journalctl --user -u pi-stack-serve
[Unit]
Description=pi-stack host services (memory :11435, knowledge :11436)

[Service]
# HostBin is systemd-quoted by the renderer (a path with spaces stays one argv
# element); Environment entries carry the install-time env capture, one quoted
# KEY=value per line (PI_STACK_CONFIG always; XDG_CONFIG_HOME / MEMORY_DB /
# MEMORY_PORT / KNOWLEDGE_PORT / OLLAMA_HOST when set at install time).
ExecStart={{.HostBin}} serve
{{- range .Env}}
Environment={{.Value}}
{{- end}}
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
